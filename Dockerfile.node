# Dockerfile.node (Node / Vite)
FROM node:18

WORKDIR /var/www/html

# Copy package files and install dependencies (caches on build)
COPY package*.json /var/www/html/
RUN npm ci --silent || npm install --silent

# Copy rest of project (overridden by volume in compose)
COPY . /var/www/html

EXPOSE 5173

# Start Vite dev server bound to 0.0.0.0
CMD ["sh", "-c", "npm run dev -- --host 0.0.0.0"]
