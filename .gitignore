# --- PERBAIKAN DI SINI ---

# Biarkan folder public di-track oleh Git sepenuhnya
# Kita HAPUS baris /public/storage agar folder fasilitas di dalamnya ikut naik
!/public/assets/
!/public/storage/

# Tetap abaikan file log dan cache di folder storage asli
/storage/app/*
/storage/framework/cache/data/*
/storage/framework/views/*
/storage/framework/sessions/*
/storage/logs/*

# Pastikan folder resources/assets tidak diabaikan (karena di gambar kamu pakai SCSS/JS)
!resources/assets/
